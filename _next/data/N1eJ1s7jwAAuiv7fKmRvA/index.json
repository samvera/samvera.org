{"pageProps":{"blogPosts":[{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"gmxjheo1ix1o"}},"id":"3Rs0oWwPavzfuH8IDkQfg5","type":"Entry","createdAt":"2026-07-07T14:39:05.864Z","updatedAt":"2026-07-07T14:39:05.864Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":26,"revision":1,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"blogPost"}},"locale":"en-US"},"fields":{"title":"Avalon Media System 8.2 Released","slug":"avalon-8-2-released","publishDate":"2026-07-07T00:00-04:00","content":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The Avalon Media System team is proud to announce release 8.2!","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Avalon 8.2 includes improved object management with a revamped permissions model: Units are now full objects with their own staff and user permissions, and permissions are now inherited instead of per-object, making it easy to add read-only access to large collections for specific users and groups. 8.2 also includes support for Audio Description files, forced captions, and the latest version of the Ramp media component library.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Units and Permission Management","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Units are now full objects where user roles and default access can be set","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The \"Manage\" dashboard now allows for management of both Units and Collections","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},